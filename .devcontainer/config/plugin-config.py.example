"""
Plugin configuration for the dev container.

This file is loaded dynamically by setup.sh into NetBox's configuration.
It enables both the Interface Name Rules plugin and the LibreNMS plugin
for co-development and testing.
"""

PLUGINS = [
    "netbox_interface_name_rules",
    "netbox_librenms_plugin",
]

PLUGINS_CONFIG = {
    "netbox_interface_name_rules": {},
    "netbox_librenms_plugin": {
        "servers": {
            "production": {
                "display_name": "Production LibreNMS",
                "librenms_url": "https://librenms.example.com",
                "api_token": "your-token-here",
            },
        }
    },
}
